#!/bin/sh
set -e

APP_ID="shiye"
APP_USER="shiye"
SYSTEM_ID="shiye-system"
APP_DIR="/usr/local/${APP_ID}"
UNIT_DST="/etc/systemd/system/${SYSTEM_ID}.service"
SOCKET_PATH="/var/api/${APP_ID}.sock"

rm -f "${UNIT_DST}" 2>/dev/null || true
if [ -S "${SOCKET_PATH}" ]; then
    rm -f "${SOCKET_PATH}" 2>/dev/null || true
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl reset-failed "${SYSTEM_ID}.service" 2>/dev/null || true
fi

case "$1" in
    remove|purge)
        # webui/ is generated by postinst and is not owned by the Deb payload.
        # Remove only this application's directory; never touch shared paths.
        rm -rf "${APP_DIR}" 2>/dev/null || true
        ;;
esac

if [ "$1" = "purge" ] && id "${APP_USER}" >/dev/null 2>&1; then
    userdel "${APP_USER}" 2>/dev/null || true
fi
if [ "$1" = "purge" ] \
    && getent group "${APP_USER}" >/dev/null 2>&1; then
    groupdel "${APP_USER}" 2>/dev/null || true
fi

exit 0
