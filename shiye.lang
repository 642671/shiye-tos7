[zh-cn]
name = "拾页"
auth = "Yuii"
descript = "原生运行在 TOS 7 上的阅读收件箱：订阅 RSS、Atom，或把任意网页收进稍后读；支持正文提取、分类、搜索、已读与星标、OPML 迁移和定时抓取，数据只保存在本机。"
release_note = "0.2.1：修复连接诊断。服务正常但代理或会话异常时，不再一律显示「服务离线」，而是区分网络异常、会话失效、代理异常与服务离线，并显示实际失败的请求地址；后端新增 /health 健康检查路由。"
important = "订阅由 NAS 直接抓取，文章保存在应用数据目录，不经过第三方服务。远程图片会通过本机代理加载以便去除跟踪参数。"

[zh-hk]
name = "拾頁"
auth = "Yuii"
descript = "原生運行於 TOS 7 的閱讀收件箱：訂閱 RSS、Atom，或把任何網頁收進稍後讀；支援正文擷取、分類、搜尋、已讀與星標、OPML 匯入匯出及定時抓取，資料只保存在本機。"
release_note = "0.2.1：修正連線診斷。服務正常但代理或工作階段異常時，不再一律顯示「服務離線」，而是區分網路異常、工作階段失效、代理異常與服務離線，並顯示實際失敗的請求位址；後端新增 /health 健康檢查路由。"
important = "訂閱由 NAS 直接抓取，文章保存在應用資料目錄，不經過第三方服務。遠端圖片會透過本機代理載入以移除追蹤參數。"

[en-us]
name = "Shiye"
auth = "Yuii"
descript = "A reading inbox for TOS 7. Subscribe to RSS and Atom, or save any web page for later; Shiye extracts clean article text and keeps categories, search, read and starred states, OPML migration, and scheduled fetching on your NAS."
release_note = "0.2.1: connection diagnosis fixes. The app no longer reports every failure as “service offline”; it distinguishes network, session, gateway and offline errors and shows the request URL that failed. The backend also accepts /health as a health-check route."
important = "Feeds are fetched directly by the NAS and articles are stored in the app data directory, never routed through a third-party service. Remote images load through a local proxy so tracking parameters can be removed."

[fr-fr]
name = "Shiye"
auth = "Yuii"
descript = "Une boîte de lecture native pour TOS 7. Abonnez-vous à des flux RSS et Atom ou enregistrez n'importe quelle page pour plus tard ; Shiye extrait le texte propre et conserve catégories, recherche, états lu et favori, migration OPML et actualisation planifiée sur votre NAS."
release_note = "0.2.1 : correction du diagnostic de connexion. L’application ne signale plus chaque échec comme « service hors ligne » ; elle distingue les erreurs réseau, de session, de passerelle et de service, et affiche l’adresse de la requête en échec. Le backend accepte aussi /health."
important = "Les flux sont récupérés directement par le NAS et les articles sont stockés dans le dossier de données de l'application, sans passer par un service tiers. Les images distantes passent par un proxy local afin de supprimer les paramètres de suivi."

[de-de]
name = "Shiye"
auth = "Yuii"
descript = "Ein Lese-Posteingang für TOS 7. Abonniere RSS und Atom oder speichere beliebige Webseiten für später; Shiye extrahiert sauberen Text und behält Kategorien, Suche, Gelesen- und Favoritenstatus, OPML-Migration und geplantes Abrufen auf deinem NAS."
release_note = "0.2.1: Korrektur der Verbindungsdiagnose. Die App meldet nicht mehr jeden Fehler als „Dienst offline“, sondern unterscheidet Netzwerk-, Sitzungs-, Gateway- und Dienstfehler und zeigt die fehlgeschlagene Anfrage-URL. Das Backend akzeptiert außerdem /health."
important = "Feeds werden direkt vom NAS abgerufen und Artikel im Datenverzeichnis der App gespeichert, ohne Umweg über einen Drittanbieter. Remote-Bilder werden über einen lokalen Proxy geladen, damit Tracking-Parameter entfernt werden können."

[it-it]
name = "Shiye"
auth = "Yuii"
descript = "Una casella di lettura nativa per TOS 7. Iscriviti a feed RSS e Atom o salva qualsiasi pagina per dopo; Shiye estrae il testo pulito e mantiene categorie, ricerca, stati letto e preferito, migrazione OPML e aggiornamento pianificato sul tuo NAS."
release_note = "0.2.1: correzione della diagnosi di connessione. L’app non segnala più ogni errore come «servizio offline»; ora distingue errori di rete, sessione, gateway e servizio e mostra l’indirizzo della richiesta fallita. Il backend accetta anche /health."
important = "I feed vengono scaricati direttamente dal NAS e gli articoli sono salvati nella cartella dati dell'app, senza servizi di terze parti. Le immagini remote passano da un proxy locale per rimuovere i parametri di tracciamento."

[es-es]
name = "Shiye"
auth = "Yuii"
descript = "Una bandeja de lectura nativa para TOS 7. Suscríbete a RSS y Atom o guarda cualquier página para después; Shiye extrae el texto limpio y mantiene categorías, búsqueda, estados leído y favorito, migración OPML y actualización programada en tu NAS."
release_note = "0.2.1: corrección del diagnóstico de conexión. La aplicación ya no muestra todos los fallos como «servicio sin conexión»; distingue errores de red, sesión, puerta de enlace y servicio, y muestra la dirección de la solicitud fallida. El backend también acepta /health."
important = "El NAS obtiene los feeds directamente y los artículos se guardan en el directorio de datos de la aplicación, sin pasar por servicios de terceros. Las imágenes remotas se cargan mediante un proxy local para eliminar los parámetros de seguimiento."

[hu-hu]
name = "Shiye"
auth = "Yuii"
descript = "Natív olvasópostafiók TOS 7-hez. Iratkozz fel RSS- és Atom-hírcsatornákra, vagy ments el bármilyen weboldalt későbbre; a Shiye tiszta szöveget nyer ki, és a NAS-on tartja a kategóriákat, keresést, olvasott és csillagozott állapotot, OPML-migrációt és ütemezett frissítést."
release_note = "0.2.1: kapcsolatdiagnosztika javítása. Az alkalmazás már nem jelez minden hibát „szolgáltatás offline” állapotként; megkülönbözteti a hálózati, munkamenet-, átjáró- és szolgáltatáshibákat, és megmutatja a sikertelen kérés címét. A háttérrendszer a /health útvonalat is elfogadja."
important = "A hírcsatornákat a NAS tölti le, a cikkek az alkalmazás adatkönyvtárában tárolódnak, harmadik fél szolgáltatás nélkül. A távoli képek helyi proxyn keresztül töltődnek be, hogy a követési paraméterek eltávolíthatók legyenek."

[ja-jp]
name = "Shiye"
auth = "Yuii"
descript = "TOS 7 向けのネイティブな読書インボックス。RSS / Atom を購読するか、任意の Web ページを「あとで読む」に保存。本文抽出、カテゴリ、検索、既読・スター、OPML 移行、定期取得に対応し、データは NAS 上に保存されます。"
release_note = "0.2.1：接続診断を修正。サービスが正常でもプロキシやセッションに問題がある場合に「サービスオフライン」とだけ表示せず、ネットワーク・セッション・ゲートウェイ・サービス停止を区別し、失敗したリクエスト URL を表示します。バックエンドは /health も受け付けます。"
important = "フィードは NAS が直接取得し、記事はアプリのデータディレクトリに保存されます。第三者サービスは経由しません。リモート画像はローカルプロキシ経由で読み込み、追跡パラメータを除去します。"

[ko-kr]
name = "Shiye"
auth = "Yuii"
descript = "TOS 7용 네이티브 읽기 받은편지함. RSS와 Atom을 구독하거나 어떤 웹 페이지든 나중에 읽기로 저장하세요. Shiye가 깨끗한 본문을 추출하며 카테고리, 검색, 읽음 및 별표, OPML 이전, 예약 새로고침을 NAS에 보관합니다."
release_note = "0.2.1: 연결 진단 수정. 서비스가 정상이어도 프록시나 세션에 문제가 있으면 ‘서비스 오프라인’으로만 표시하지 않고 네트워크, 세션, 게이트웨이, 서비스 오류를 구분하며 실패한 요청 URL을 보여 줍니다. 백엔드는 /health 경로도 지원합니다."
important = "피드는 NAS가 직접 가져오며 기사는 앱 데이터 디렉터리에 저장되고 제3자 서비스를 거치지 않습니다. 원격 이미지는 로컬 프록시를 통해 불러와 추적 매개변수를 제거합니다."

[pl-pl]
name = "Shiye"
auth = "Yuii"
descript = "Natywna skrzynka czytelnicza dla TOS 7. Subskrybuj RSS i Atom lub zapisuj dowolne strony na później; Shiye wyodrębnia czysty tekst i przechowuje kategorie, wyszukiwanie, stany przeczytane i gwiazdka, migrację OPML oraz zaplanowane odświeżanie na NAS."
release_note = "0.2.1: poprawki diagnostyki połączenia. Aplikacja nie pokazuje już każdego błędu jako „usługa offline”; rozróżnia błędy sieci, sesji, bramy i usługi oraz wyświetla adres nieudanego żądania. Backend obsługuje także /health."
important = "Kanały są pobierane bezpośrednio przez NAS, a artykuły zapisywane w katalogu danych aplikacji, bez pośrednictwa usług zewnętrznych. Obrazy zdalne ładują się przez lokalny proxy, aby usuwać parametry śledzące."

[ru-ru]
name = "Shiye"
auth = "Yuii"
descript = "Нативная читательская папка для TOS 7. Подписывайтесь на RSS и Atom или сохраняйте любые веб-страницы на потом; Shiye извлекает чистый текст и хранит категории, поиск, состояния прочитано и избранное, перенос OPML и обновление по расписанию на вашем NAS."
release_note = "0.2.1: исправлена диагностика подключения. Приложение больше не показывает любую ошибку как «служба недоступна», а различает сетевые ошибки, ошибки сеанса, шлюза и службы и показывает адрес неудачного запроса. Бэкенд также принимает /health."
important = "Ленты загружаются напрямую с NAS, а статьи хранятся в каталоге данных приложения без сторонних сервисов. Удалённые изображения загружаются через локальный прокси, чтобы удалять параметры отслеживания."

[tr-tr]
name = "Shiye"
auth = "Yuii"
descript = "TOS 7 için yerel bir okuma gelen kutusu. RSS ve Atom abonelikleri ekleyin veya herhangi bir web sayfasını sonra okumak üzere kaydedin; Shiye temiz metni çıkarır ve kategorileri, aramayı, okundu ve yıldızlı durumları, OPML taşımayı ve zamanlanmış yenilemeyi NAS'ınızda tutar."
release_note = "0.2.1: bağlantı tanılama düzeltmeleri. Uygulama artık her hatayı “hizmet çevrimdışı” olarak göstermiyor; ağ, oturum, ağ geçidi ve hizmet hatalarını ayırt ediyor ve başarısız istek adresini gösteriyor. Arka uç artık /health yolunu da kabul ediyor."
important = "Akışlar doğrudan NAS tarafından alınır ve makaleler üçüncü taraf hizmetlerden geçmeden uygulamanın veri dizininde saklanır. Uzak görseller izleme parametrelerini kaldırmak için yerel bir proxy üzerinden yüklenir."

[pt-pt]
name = "Shiye"
auth = "Yuii"
descript = "Uma caixa de leitura nativa para TOS 7. Subscreva RSS e Atom ou guarde qualquer página para mais tarde; o Shiye extrai o texto limpo e mantém categorias, pesquisa, estados lido e favorito, migração OPML e atualização agendada no seu NAS."
release_note = "0.2.1: correção do diagnóstico de ligação. A aplicação já não mostra todas as falhas como «serviço offline»; distingue erros de rede, sessão, gateway e serviço e mostra o endereço do pedido falhado. O backend também aceita /health."
important = "Os feeds são obtidos diretamente pelo NAS e os artigos são guardados na pasta de dados da aplicação, sem serviços de terceiros. As imagens remotas são carregadas através de um proxy local para remover os parâmetros de rastreamento."
