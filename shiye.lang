[en-us]
name = "Shiye"
auth = "Yuii"
descript = "A native RSS and Atom reader for TOS 7 with categories, search, read and starred states, OPML import and export, and scheduled fetching. Articles stay on your NAS."
release_note = "0.1.0: first release with RSS 2.0, RSS 1.0 and Atom support, categories, full-text search, read and starred states, OPML import and export, scheduled refresh, and light and dark themes."
important = "Feeds are fetched directly by the NAS and articles are stored in the app data directory, never routed through a third-party service. Remote images load through a local proxy so tracking parameters can be removed."

